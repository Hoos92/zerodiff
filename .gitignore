# Recorded traces and generated reports may contain sensitive runtime data.
# Never commit them by default.
traces/
**/traces/
zerodiff-report.json
zerodiff-report.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# run artifacts and keys must never be committed
.zerodiff/
**/.zerodiff/
zerodiff-attestation.json
zerodiff-junit.xml
zerodiff-fix-prompt.md
*.key

# legacy artifact names, from before the NoDrift -> ZeroDiff rename.
# Anyone upgrading has these lying around; they must not get swept up.
nodrift-report.json
nodrift-report.md
nodrift-attestation.json
nodrift-junit.xml
nodrift-fix-prompt.md
.nodrift/
**/.nodrift/

# environment files: these hold live API keys and must never be
# committed. The repo is public.
.env
.env.*
!.env.example
